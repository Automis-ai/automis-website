.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Screenshot tooling (local dev only — not for production)
screenshot.mjs
temporary screenshots/

# Generated by next-sitemap in postbuild, on every build.
# Not committed on purpose: the versioned copy went stale within a day and was
# actively misleading (it once made a stale sitemap look like a live one), while
# adding nothing — if next-sitemap fails, postbuild exits non-zero, the build fails
# and the deploy never ships, so there is no scenario where a stale committed copy
# would have served as a fallback.
public/robots.txt
public/sitemap.xml
public/sitemap-0.xml
